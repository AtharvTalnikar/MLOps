# Multistage Dockerfile

### Builder stage: install deps and train model
FROM python:3.9-slim AS builder

ENV VENV_PATH=/opt/venv
WORKDIR /app

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/

RUN python -m venv ${VENV_PATH} \
	&& ${VENV_PATH}/bin/pip install --upgrade pip setuptools wheel \
	&& ${VENV_PATH}/bin/pip install --no-cache-dir -r requirements.txt

COPY src/model_training.py /app/
COPY src/train_sklearn.py /app/
RUN ${VENV_PATH}/bin/python model_training.py \
    && ${VENV_PATH}/bin/python train_sklearn.py


FROM python:3.9-slim AS runtime

ENV VENV_PATH=/opt/venv
WORKDIR /app

# Copy the trained model from the builder stage
COPY --from=builder /app/my_model.keras /app/
COPY --from=builder /app/iris_rf.joblib /app/

# Copy the virtualenv with installed packages from builder. This avoids
# reinstalling heavy packages in the runtime image and removes build-time
# tooling and cache layers.
COPY --from=builder ${VENV_PATH} ${VENV_PATH}

ENV PATH=${VENV_PATH}/bin:$PATH

COPY src/main.py /app/
COPY src/templates /app/templates
COPY src/statics /app/statics

# Expose the port the Flask app uses
EXPOSE 4000

ENV FLASK_ENV=production

CMD ["python", "main.py"]
